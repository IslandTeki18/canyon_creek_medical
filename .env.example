# Names only — never commit values. See .claude/CLAUDE.md for secret handling rules.

# Convex (set by `npx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Deployment environment: development | preview | staging | production.
# Controls contact captcha policy; unset/unknown values mean development.
APP_ENV=

# Clerk (Increment 1)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Convex deployment env var: Clerk frontend API URL, e.g. https://foo.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Contact form
VITE_TURNSTILE_SITE_KEY=
# Convex deployment variable (never a VITE_* value)
TURNSTILE_SECRET_KEY=
