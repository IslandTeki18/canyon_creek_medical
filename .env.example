# Names only — never commit values. See CLAUDE.md for secret handling rules.

# Convex (set by `npx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Deployment environment: development | preview | staging | production.
# Drives feature-flag defaults (Increment 12.2). Unset means development.
APP_ENV=

# Clerk (Increment 1)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Convex deployment env var: Clerk frontend API URL, e.g. https://foo.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Twilio (Increment 6)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
COMMUNICATION_CALLBACK_BASE_URL=
PRACTICE_NAME=Canyon Creek
PRACTICE_PHONE=

# Resend (Increment 6)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
